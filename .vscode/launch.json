{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Launch Flask (Debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "args": ["--app", "main:app", "run", "--debug", "--port", "9000"],
      "jinja": true,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Running on .*:(\\d+)",
        "uriFormat": "http://localhost:%s/docs"
      }
    }
  ]
}
